{
  "name": "@cf-sync/client",
  "version": "0.1.0",
  "description": "Browser client for cf-sync: SyncClient (optimistic mutations, offline outbox, IndexedDB mirror, presence) and a TanStack DB collection adapter, with React hooks",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/InfinityBowman/cf-sync.git",
    "directory": "packages/client"
  },
  "homepage": "https://github.com/InfinityBowman/cf-sync#readme",
  "keywords": [
    "sync",
    "sync-engine",
    "local-first",
    "offline-first",
    "optimistic-updates",
    "tanstack-db",
    "react",
    "indexeddb",
    "presence"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./react": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "node ../../scripts/sync-docs.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cf-sync/protocol": "workspace:^"
  },
  "peerDependencies": {
    "@tanstack/db": "^0.6.16",
    "@tanstack/react-db": "^0.1.94",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-db": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cf-sync/yjs": "workspace:*",
    "@tanstack/db": "^0.6.16",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.3",
    "fake-indexeddb": "^6.2.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.6.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "yjs": "^13.6.31",
    "zod": "^4.0.0"
  }
}
