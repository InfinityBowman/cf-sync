{
  "name": "@cf-sync/protocol",
  "version": "0.1.1",
  "description": "Shared app-definition kit and wire protocol for cf-sync: defineApp, defineSchema, defineMutators, zod-validated frames \u2014 importable from both worker and browser",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/InfinityBowman/cf-sync.git",
    "directory": "packages/protocol"
  },
  "homepage": "https://github.com/InfinityBowman/cf-sync#readme",
  "keywords": [
    "sync",
    "sync-engine",
    "local-first",
    "offline-first",
    "cloudflare",
    "durable-objects",
    "zod"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./internal": "./src/internal.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./internal": {
        "types": "./dist/internal.d.ts",
        "default": "./dist/internal.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "zod": "^4.0.0"
  }
}
