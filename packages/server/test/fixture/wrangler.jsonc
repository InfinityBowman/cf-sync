{
  "name": "cf-sync-test-fixture",
  "main": "./worker.ts",
  "compatibility_date": "2025-08-01",
  "durable_objects": {
    "bindings": [
      { "name": "WORKSPACE", "class_name": "WorkspaceDO" },
      { "name": "COMPACT", "class_name": "CompactingDO" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WorkspaceDO", "CompactingDO"] }],
  "r2_buckets": [{ "binding": "EXPORT_BUCKET", "bucket_name": "cf-sync-test-export" }]
}
