{
  "name": "@cf-sync/server",
  "version": "0.0.0",
  "private": true,
  "description": "Server-authoritative sync engine on Cloudflare Durable Objects: createWorkspaceDO, worker routers, admin surface, and an in-memory test engine",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/InfinityBowman/cf-sync-engine.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/InfinityBowman/cf-sync-engine#readme",
  "keywords": [
    "sync",
    "sync-engine",
    "local-first",
    "offline-first",
    "cloudflare",
    "durable-objects",
    "workers",
    "websocket"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./testing": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cf-sync/protocol": "workspace:*"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.6",
    "@cloudflare/workers-types": "^5.20260718.1",
    "@types/node": "^26.1.1",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.0.0",
    "zod": "^4.0.0"
  }
}
