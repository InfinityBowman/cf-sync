{
  "name": "@cf-sync/yjs",
  "version": "0.2.0",
  "description": "Collaborative-text add-on for cf-sync: Yjs fields living in the same Workspace Durable Object, exposed as an engine extension (server) and field handles (client)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/InfinityBowman/cf-sync.git",
    "directory": "packages/yjs"
  },
  "homepage": "https://github.com/InfinityBowman/cf-sync#readme",
  "keywords": [
    "yjs",
    "crdt",
    "collaborative-editing",
    "sync",
    "local-first",
    "cloudflare",
    "durable-objects"
  ],
  "type": "module",
  "exports": {
    "./server": "./src/server.ts",
    "./client": "./src/client.ts",
    "./react": "./src/react.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      "./server": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      },
      "./client": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      },
      "./react": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "node ../../scripts/sync-docs.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cf-sync/protocol": "workspace:^"
  },
  "peerDependencies": {
    "@cf-sync/server": "workspace:^",
    "react": ">=18",
    "yjs": "^13.6.0"
  },
  "peerDependenciesMeta": {
    "@cf-sync/server": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cf-sync/server": "workspace:*",
    "@cloudflare/vitest-pool-workers": "^0.18.6",
    "@cloudflare/workers-types": "^5.20260718.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.3",
    "happy-dom": "^20.11.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^5.6.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wrangler": "^4.0.0",
    "yjs": "^13.6.0",
    "zod": "^4.0.0"
  }
}
