{
  "name": "@cf-sync/yjs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./server": "./src/server.ts",
    "./client": "./src/client.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "exports": {
      "./server": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      },
      "./client": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cf-sync/protocol": "workspace:*"
  },
  "peerDependencies": {
    "@cf-sync/server": "workspace:*",
    "yjs": "^13.6.0"
  },
  "peerDependenciesMeta": {
    "@cf-sync/server": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cf-sync/server": "workspace:*",
    "@cloudflare/vitest-pool-workers": "^0.18.6",
    "@cloudflare/workers-types": "^5.20260718.1",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.0.0",
    "yjs": "^13.6.0",
    "zod": "^4.0.0"
  }
}
